# =============================================================================
# Healthcare Appointment & Follow-up Manager - Environment Configuration
# =============================================================================

# Server Port
PORT=8080

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthcare_db
DB_USER=root
DB_PASSWORD=root

# JWT Security
JWT_SECRET=c674e30ef480ad9be29a1f2da930f3aa8f2c3d5e7a9b1c2d3e4f5a6b7c8d9e0f
JWT_EXPIRATION_MS=86400000

# OpenAI Integration (Optional - Falls back to simulated clinical AI)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Calendar OAuth 2.0 (Optional - Falls back to simulated calendar sync & .ics export)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/callback

# JavaMail SMTP (Optional - Logs to console if not configured)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@healthcareapp.com

# Frontend URL
APP_FRONTEND_URL=http://localhost:5173
