# Production Frontend Environment Variables (Vercel)
# Set this in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables

# The public HTTPS base URL of your deployed Spring Boot backend + /api
# Example (Render): https://healthcare-appointment-backend.onrender.com/api
# Example (Railway): https://appointment-manager-production.up.railway.app/api
# Example (Custom Domain): https://api.yourdomain.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api
